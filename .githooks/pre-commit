#!/usr/bin/env bash
# Formats the staged Go and web files and re-stages them, so the CI format
# gates rarely fail. Formatting only: lint and tests stay in CI and `make`, to
# keep the hook fast enough that nobody reaches for --no-verify. Enabled by
# `make setup`. Partially staged files are formatted whole and re-staged whole.
set -euo pipefail

root=$(git rev-parse --show-toplevel)
cd "$root"

if command -v gitleaks >/dev/null 2>&1; then
  if gitleaks help git >/dev/null 2>&1; then
    staged_scan=(git --staged)
  else
    staged_scan=(protect --staged)
  fi
  if ! gitleaks "${staged_scan[@]}" --no-banner --redact --config .gitleaks.toml; then
    echo "pre-commit: gitleaks found a secret in the staged changes; remove it before committing" >&2
    exit 1
  fi
else
  echo "pre-commit: gitleaks not installed locally; skipping the staged secret scan" >&2
fi

mapfile -d '' go_files < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*.go')
if ((${#go_files[@]})); then
  gofmt -w "${go_files[@]}"
  git add -- "${go_files[@]}"
fi

mapfile -d '' comment_files < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*.go' '*.ts' '*.tsx')
if ((${#comment_files[@]})); then
  if ! go run ./backend/cmd/nocomments -- "${comment_files[@]}"; then
    echo "pre-commit: comments are not allowed in Go and TS/TSX sources (see AGENTS.md, Comments)" >&2
    exit 1
  fi
fi

mapfile -d '' web_files < <(git diff --cached --name-only --diff-filter=ACMR -z -- 'web/')
if ((${#web_files[@]})); then
  if [[ ! -x web/node_modules/.bin/prettier ]]; then
    echo "pre-commit: web/node_modules is missing; run 'npm ci' in web/ (skipping Prettier)" >&2
    exit 0
  fi
  relative=("${web_files[@]#web/}")
  (cd web && node_modules/.bin/prettier --write --ignore-unknown --log-level warn -- "${relative[@]}")
  git add -- "${web_files[@]}"
fi
