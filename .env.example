# Database configuration (required)
DATABASE_URI=mongodb://localhost:27017/

# Database name (optional, defaults to "legnaris")
DATABASE_NAME=legnaris

# Database timeouts (optional, Go duration format e.g. 1s, 500ms, 2m)
# DATABASE_PING_TIMEOUT=1s
# DATABASE_SERVER_SELECTION_TIMEOUT=2s
# DATABASE_CONNECT_TIMEOUT=2s
# DATABASE_CLOSE_TIMEOUT=5s