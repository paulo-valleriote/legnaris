# `make dev` needs no .env: it starts its own clean MongoDB and uses throwaway
# development secrets. Fill this file only to run the pieces separately
# (`make dev-db`, `make run`) or to override the secrets `make dev` uses.

# Database configuration (required)
# Credentials are required: `make dev-db` starts a local MongoDB replica set with a
# keyfile, which turns authorization on, using exactly these root credentials, so
# app and tests always authenticate against it. Credentials must stay verbatim (no
# percent-encoding). The password is development-only.
DATABASE_URI=mongodb://root:legnaris-dev-only@localhost:27017/?replicaSet=rs0&retryWrites=true&authSource=admin

# Database name (optional, defaults to "legnaris")
DATABASE_NAME=legnaris

# Database timeouts (optional, go duration format e.g. 1s, 500ms, 2m)
# DATABASE_PING_TIMEOUT=1s
# DATABASE_SERVER_SELECTION_TIMEOUT=2s
# DATABASE_CONNECT_TIMEOUT=2s
# DATABASE_CLOSE_TIMEOUT=5s

# Authentication (JWT_SECRET is required)
# Secret used to sign access tokens (HS256). Generate a long random value, e.g.
# `openssl rand -base64 48`, and keep it out of version control.
JWT_SECRET=

# Key for the one-time email code digest (required, at least 32 bytes and
# different from JWT_SECRET). Generate it the same way as JWT_SECRET.
EMAIL_CODE_SECRET=

# API listen port (optional, defaults to 8080)
# PORT=8080

# Access token TTL (optional, defaults to 15m)
# JWT_ACCESS_TTL=15m

# Refresh token TTL (optional, defaults to 720h / 30 days)
# AUTH_REFRESH_TTL=720h

# bcrypt cost for password hashing (optional, defaults to 12, must be >= 12)
# AUTH_BCRYPT_COST=12

# Rate limit for POST /csp-report (optional, defaults to 30 attempts per 1m).
# Reports are kept on their own budget so a page's violation burst never
# consumes the auth rate limit.
# CSP_REPORT_RATE_LIMIT_ATTEMPTS=30
# CSP_REPORT_RATE_LIMIT_WINDOW=1m

# Registration budgets for POST /auth/register (optional). Each real client address
# and each canonical e-mail has its own hourly budget: 5 per 1h and 3 per 1h by default.
# AUTH_REGISTER_IP_RATE_LIMIT_ATTEMPTS=5
# AUTH_REGISTER_IP_RATE_LIMIT_WINDOW=1h
# AUTH_REGISTER_EMAIL_RATE_LIMIT_ATTEMPTS=3
# AUTH_REGISTER_EMAIL_RATE_LIMIT_WINDOW=1h

# Rate limit per authenticated user on /sheets, /templates and GET /auth/me (optional,
# defaults to 80 attempts per 1m).
# USER_RATE_LIMIT_ATTEMPTS=80
# USER_RATE_LIMIT_WINDOW=1m

# GET /health, GET /ready and GET /metrics are never rate limited.

# CORS allowed origins (optional, comma-separated for the web/admin surface)
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
