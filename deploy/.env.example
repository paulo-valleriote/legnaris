# =============================================================================
# Legnaris — environment (copy to .env and fill every replace_me value)
# =============================================================================

# ---- Domains & TLS (Let's Encrypt) -------------------------------------------
# api.legnaris.com.br -> Docker/Traefik, public API (no auth)
# ops.legnaris.com.br -> Docker/Traefik, observability + GitHub OAuth callback
# Both DNS records (A/CNAME) must resolve to this host before starting.
API_DOMAIN=api.legnaris.com.br
OPS_DOMAIN=ops.legnaris.com.br
ACME_EMAIL=you@example.com

# ---- CORS (origins allowed to call the API from the browser) ----------------
# Comma-separated. The frontend origin (Vercel) must be listed here.
CORS_ALLOWED_ORIGINS=https://legnaris.com.br

# ---- GitHub OAuth (oauth2-proxy) ---------------------------------------------
# Create an OAuth App: GitHub -> Settings -> Developer settings -> OAuth Apps
#   Homepage URL:  https://api.legnaris.com.br
#   Callback URL:  https://ops.legnaris.com.br/oauth2/callback
GITHUB_CLIENT_ID=replace_me
GITHUB_CLIENT_SECRET=replace_me
# GitHub username(s) allowed to log in (comma-separated).
GITHUB_USER=your-github-username
# Generate with:  openssl rand -base64 32 | tr '+/' '-_'
# (oauth2-proxy expects URL-safe base64 of 16/24/32 bytes)
OAUTH2_PROXY_COOKIE_SECRET=replace_me

# ---- MongoDB -----------------------------------------------------------------
MONGO_ROOT_PASSWORD=replace_me
# Least-privileged credentials provisioned by deploy/mongodb/init on first boot.
# IMPORTANT: these three passwords are embedded verbatim in connection URIs, so
# they must be URL-safe — letters, digits, and only these symbols: - _ . ~
# (avoid @ : / ? # % & + =, which would break or mis-parse the URI).
MONGO_APP_PASSWORD=replace_me
MONGO_EXPORTER_PASSWORD=replace_me
MONGO_VIEW_PASSWORD=replace_me

# ---- Mongo Express (basic auth, defense in depth) ----------------------------
ME_CONFIG_BASICAUTH_USERNAME=admin
ME_CONFIG_BASICAUTH_PASSWORD=replace_me

# ---- Grafana ------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_me
