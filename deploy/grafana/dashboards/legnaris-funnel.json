        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(legnaris_funnel_first_sheet_within_24h_ratio{job=\"legnaris-app\"})",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
