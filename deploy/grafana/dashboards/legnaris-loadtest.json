  "templating": {
    "list": [
      {
        "name": "testid",
        "label": "Test",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "refresh": 2,
        "query": {
          "query": "label_values(k6_http_reqs_total, testid)",
          "refId": "t"
