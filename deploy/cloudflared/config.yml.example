# Cloudflare Tunnel ingress (named tunnel). Copy to config.yml and fill in the
# tunnel UUID from `cloudflared tunnel list`.
#
# Setup (host, once):
#   cloudflared tunnel login
#   cloudflared tunnel create legnaris
#   cloudflared tunnel route dns legnaris api-legnaris.paulovalleriote.io
#   cloudflared tunnel route dns legnaris legnaris.paulovalleriote.io
#   cloudflared tunnel route dns legnaris ops-legnaris.paulovalleriote.io
#   cp config.yml.example config.yml   # then set the tunnel UUID below

tunnel: <TUNNEL_UUID>
credentials-file: /home/nonroot/.cloudflared/<TUNNEL_UUID>.json

ingress:
  - hostname: api-legnaris.paulovalleriote.io
    service: http://traefik:80
  - hostname: legnaris.paulovalleriote.io
    service: http://traefik:80
  - hostname: ops-legnaris.paulovalleriote.io
    service: http://traefik:80
  - service: http_status:404
