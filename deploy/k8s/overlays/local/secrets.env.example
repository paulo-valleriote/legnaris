# Copy to secrets.env (gitignored) or let `make k8s-up` generate it with random
# values. Passwords are embedded in connection URIs: keep them URL-safe.
MONGO_ROOT_PASSWORD=replace_me
MONGO_APP_PASSWORD=replace_me
MONGO_EXPORTER_PASSWORD=replace_me
MONGO_VIEW_PASSWORD=replace_me
JWT_SECRET=replace_me
EMAIL_CODE_SECRET=replace_me
RABBITMQ_PASSWORD=replace_me
RABBITMQ_OPS_PASSWORD=replace_me
