{"data":{"id":"fantasy_v1","name":"Fantasy Template","fields":{"baseArmorClass":{"schema":{"type":"number","label":"","is_editable":true,"default":10}},"config":{"children":{"acUsesCon":{"schema":{"type":"number","label":"","is_editable":true,"default":0}},"acUsesDex":{"schema":{"type":"number","label":"","is_editable":true,"default":1}},"spellUsesInt":{"schema":{"type":"number","label":"","is_editable":true,"default":0}},"spellUsesWis":{"schema":{"type":"number","label":"","is_editable":true,"default":0}},"stealthProfWeight":{"schema":{"type":"number","label":"","is_editable":true,"default":0}}}},"derived":{"children":{"armorClass":{"schema":{"type":"number","label":"","formula":"baseArmorClass + (modifiers_dexterityMod * config_acUsesDex) + (modifiers_constitutionMod * config_acUsesCon)","depends_on":[["baseArmorClass"],["modifiers","dexterityMod"],["config","acUsesDex"],["modifiers","constitutionMod"],["config","acUsesCon"]],"is_editable":false,"default":0}},"stealthTotal":{"schema":{"type":"number","label":"","formula":"modifiers_dexterityMod + floor(others_proficiencyBonus * config_stealthProfWeight)","depends_on":[["modifiers","dexterityMod"],["others","proficiencyBonus"],["config","stealthProfWeight"]],"is_editable":false,"default":0}}}},"modifiers":{"children":{"constitutionMod":{"schema":{"type":"number","label":"","formula":"floor((stats_constitution - 10) / 2)","depends_on":[["stats","constitution"]],"is_editable":false,"default":0}},"dexterityMod":{"schema":{"type":"number","label":"","formula":"floor((stats_dexterity - 10) / 2)","depends_on":[["stats","dexterity"]],"is_editable":false,"default":0}}}},"others":{"children":{"proficiencyBonus":{"schema":{"type":"number","label":"","is_editable":true,"default":2}}}},"stats":{"children":{"constitution":{"schema":{"type":"number","label":"","is_editable":true,"default":10}},"dexterity":{"schema":{"type":"number","label":"","is_editable":true,"default":10}}}}},"default":true}}
